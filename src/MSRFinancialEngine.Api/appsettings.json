{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=msr_financial_engine;Username=msr_user;Password=msr_password"
  },
  "Jwt": {
    "Issuer": "MSRFinancialEngine",
    "Audience": "MSRFinancialEngine",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Auth": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 7,
    "MinimumPasswordLength": 8,
    "LoginRateLimitPerMinute": 10
  },
  "ImportWorker": {
    "PollSeconds": 10,
    "StaleJobMinutes": 30
  },
  "Retention": {
    "RefreshTokenDays": 30,
    "ImportJobDays": 90,
    "AuditEventDays": 0,
    "AuditArchivePath": "",
    "AutoArchiveAudit": false,
    "AuditArchiveLagDays": 1
  },
  "SeedAdmin": {
    "Enabled": true,
    "Name": "Administrador",
    "Email": "admin@msrfinancialengine.local",
    "Password": ""
  }
}
